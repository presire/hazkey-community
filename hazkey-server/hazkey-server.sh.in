#!/usr/bin/env sh

# hazkey-server wrapper script
# XDG_CONFIG_HOME is optional per the XDG base directory spec and is unset on
# many desktop sessions; without this fallback the path collapses to
# "/hazkey/env" and every user setting below is silently ignored.
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hazkey/env"
# Load user defined environment variables.
# `set -a` is required: the settings are consumed by the hazkey-server process
# this script exec()s at the end, and a plain `KEY=value` line in a sourced
# file only creates a shell-local variable, which is NOT part of the
# environment handed to exec. `.` is used instead of the bash-only `source`
# because this script runs under POSIX sh.
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi

# Optional Zenzai CPU settings are read by hazkey-server from the sourced file:
# HAZKEY_ZENZAI_CPU_THREADS=1..8
# HAZKEY_ZENZAI_DEADLINE_MS=0..2000 (0 disables the deadline)

# Mitigate SIGILL crash on multi-GPU systems where multiple Vulkan ICDs
# (e.g. nvidia_icd.json + radeon_icd.json) coexist.
# Ref: https://github.com/7ka-Hiira/hazkey/issues/29
# When neither VK_DRIVER_FILES nor VK_ICD_FILENAMES is set, pin the Vulkan
# loader to the first detected ICD so that ggml_backend_load_all() does not
# initialize conflicting vendor drivers simultaneously (which triggers a
# Swift runtime precondition failure -> SIGILL).
# User-provided values (via shell env or $XDG_CONFIG_HOME/hazkey/env) are
# always respected.
if [ -z "${VK_DRIVER_FILES:-}" ] && [ -z "${VK_ICD_FILENAMES:-}" ]; then
    for icd_dir in \
        /usr/share/vulkan/icd.d \
        /usr/local/share/vulkan/icd.d \
        /etc/vulkan/icd.d
    do
        [ -d "$icd_dir" ] || continue
        for f in "$icd_dir"/*.json; do
            [ -f "$f" ] || continue
            VK_DRIVER_FILES="$f"
            VK_ICD_FILENAMES="$f"
            export VK_DRIVER_FILES VK_ICD_FILENAMES
            break 2
        done
    done
fi

exec "@CMAKE_INSTALL_FULL_LIBDIR@/hazkey/hazkey-server" "$@"
